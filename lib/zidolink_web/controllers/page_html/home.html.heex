<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --cream: #FFFBF3; --panel: #FFFFFF; --yellow: #FFC93C; --teal: #0E7C5D;
    --coral: #FF6F5E; --plum: #241B2F; --text-dim: #6B6478; --mint: #EAF7EF; --border: #F1E7D6;
  }
  body { background: var(--cream); color: var(--plum); font-family: 'DM Sans', sans-serif; overflow-x: hidden; }
  .display { font-family: 'Poppins', sans-serif; font-weight: 800; }

  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; background: rgba(255,251,243,0.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
  nav .logo { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 22px; }
  nav .logo .accent { color: var(--coral); }
  nav .links { display: flex; gap: 28px; }
  nav .links a { color: var(--text-dim); text-decoration: none; font-size: 14px; font-weight: 600; }
  nav .cta { background: var(--plum); color: var(--cream); padding: 10px 20px; border-radius: 100px; text-decoration: none; font-weight: 700; font-size: 14px; white-space: nowrap; }
  @media (max-width: 700px) { nav .links { display: none; } }

  .hero { position: relative; min-height: 92vh; display: flex; align-items: flex-end; overflow: hidden; padding: 100px 24px 56px; }
  .hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hero-bg .photo-card { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s ease-in-out; }
  .hero-bg .photo-card.active { opacity: 1; }
  .hero-bg .photo-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(36,27,47,0.1) 0%, rgba(36,27,47,0.35) 55%, rgba(36,27,47,0.85) 100%); }
  .hero-dots { position: absolute; right: 16px; top: 16px; z-index: 3; display: flex; gap: 6px; }
  .hero-dots span { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,0.4); }
  .hero-dots span.active { background: #fff; }

  .hero-content { position: relative; z-index: 2; max-width: 980px; margin: 0 auto; width: 100%; color: #fff; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 20px 48px; }
  .hero-content h1 { flex: 1 1 300px; margin: 0; }
  .hero h1 { font-size: clamp(34px, 5.5vw, 64px); line-height: 1.05; }
  .hero h1 .accent { color: var(--coral); }
  .hero-info { flex: 1 1 300px; min-width: 0; }
  .hero p { font-size: 17px; color: rgba(255,255,255,0.88); line-height: 1.6; margin-bottom: 26px; }
  .hero-buttons { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-primary { background: var(--coral); color: #fff; padding: 15px 28px; border-radius: 100px; text-decoration: none; font-weight: 700; font-size: 15px; white-space: nowrap; box-shadow: 0 8px 20px rgba(255,111,94,0.4); }
  .btn-secondary { border: 2px solid #fff; color: #fff; padding: 13px 26px; border-radius: 100px; text-decoration: none; font-weight: 700; font-size: 15px; white-space: nowrap; }
  .btn-secondary:hover { background: #fff; color: var(--plum); }

  .section { padding: 72px 24px; max-width: 1200px; margin: 0 auto; }
  .section-header { text-align: center; margin-bottom: 40px; }
  .section-eyebrow { display: inline-block; color: var(--teal); background: var(--mint); font-size: 13px; font-weight: 700; padding: 8px 16px; border-radius: 100px; margin-bottom: 14px; }
  .section-header h2 { font-size: clamp(26px, 3.5vw, 38px); line-height: 1.15; }

  .roles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; perspective: 1200px; }
  .role-card { background: var(--panel); border: 1px solid var(--border); border-radius: 20px; padding: 30px 26px; transition: transform 0.4s ease, box-shadow 0.3s; transform-style: preserve-3d; box-shadow: 0 4px 16px rgba(36,27,47,0.04); }
  .role-card:hover { transform: rotateY(-6deg) rotateX(3deg) translateZ(10px); box-shadow: 0 20px 40px rgba(36,27,47,0.12); }
  .role-card .icon-dot { width: 46px; height: 46px; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px; color: var(--plum); }
  .role-card.trainer .icon-dot { background: var(--mint); }
  .role-card.client .icon-dot { background: #FFF3D6; }
  .role-card.seller .icon-dot { background: #FFE4E0; }
  .role-card h3 { font-size: 21px; margin-bottom: 10px; font-family: 'Poppins', sans-serif; font-weight: 700; }
  .role-card p { color: var(--text-dim); font-size: 15px; line-height: 1.6; }
  .role-card .card-link { display: inline-block; margin-top: 14px; color: var(--coral); font-weight: 700; font-size: 14px; text-decoration: none; }
  .role-card .card-link:hover { text-decoration: underline; }
</style>

<nav>
  <div class="logo">ZIDO<span class="accent">LINK</span></div>
  <div class="links">
    <a href="#roles">For Trainers</a>
    <a href="#roles">For Clients</a>
    <a href="#roles">For Sellers</a>
  </div>
  <a href="/users/register" class="cta">Get Started</a>
</nav>

<section class="hero">
  <div class="hero-bg" id="hero-bg">
    <div class="photo-card active"><img src="https://res.cloudinary.com/daqnekpeo/image/upload/w_1600,q_auto,f_auto/v1786441431/hero-1_nozfov.jpg" alt="Weightlifting" /></div>
    <div class="photo-card"><img src="https://res.cloudinary.com/daqnekpeo/image/upload/w_1600,q_auto,f_auto/v1786441354/hero-2_qf0aiz.jpg" alt="Meal prep" /></div>
    <div class="photo-card"><img src="https://res.cloudinary.com/daqnekpeo/image/upload/w_1600,q_auto,f_auto/v1786441346/hero-3_jpqway.jpg" alt="Running" /></div>
    <div class="photo-card"><img src="https://res.cloudinary.com/daqnekpeo/image/upload/w_1600,q_auto,f_auto/v1786441342/hero-4_vzegss.jpg" alt="Group training" /></div>
  </div>
  <div class="hero-overlay"></div>

  <div class="hero-dots" id="hero-dots"></div>

  <div class="hero-content">
    <h1 class="display">Fuel the grind.<br>Track the <span class="accent">gains</span>.</h1>
    <div class="hero-info">
      <p>One place for trainers to manage clients, plan meals and workouts, and sell their expertise &mdash; and for clients to find the right trainer, on their terms.</p>
      <div class="hero-buttons">
        <a href="/users/register?role=trainer" class="btn-primary">Join as a Trainer</a>
        <a href="/trainers" class="btn-secondary">Find a Trainer</a>
      </div>
    </div>
  </div>
</section>

<section class="section" id="roles">
  <div class="section-header">
    <span class="section-eyebrow">Trainers &middot; Clients &middot; Sellers</span>
    <h2 class="display">Whoever you are, there's a lane for you.</h2>
  </div>
  <div class="roles-grid">
    <div class="role-card trainer">
      <div class="icon-dot">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="20" x2="4" y2="12"/><line x1="12" y1="20" x2="12" y2="6"/>
          <line x1="20" y1="20" x2="20" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/>
        </svg>
      </div>
      <h3>Run your business, not a spreadsheet</h3>
      <p>Manage clients, track their meals and steps, plan workouts, and sell your own products, ebooks and videos.</p>
      <a href="/users/register?role=trainer" class="card-link">Join as a trainer &rarr;</a>
    </div>
    <div class="role-card client">
      <div class="icon-dot">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/>
          <rect x="4" y="9" width="3" height="6" rx="1"/><rect x="17" y="9" width="3" height="6" rx="1"/>
          <line x1="7" y1="12" x2="17" y2="12"/>
        </svg>
      </div>
      <h3>Find your trainer, on your terms</h3>
      <p>Browse trainers near you, book a single session or subscribe, and switch anytime.</p>
      <a href="/trainers" class="card-link">Browse trainers &rarr;</a>
    </div>
    <div class="role-card seller">
      <div class="icon-dot">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
      </div>
      <h3>Sell what fuels the grind</h3>
      <p>List gym wear, equipment, or nutrition products to a built-in audience.</p>
      <a href="/users/register?role=seller" class="card-link">Sell with us &rarr;</a>
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.hero-bg .photo-card');
  const dotsContainer = document.getElementById('hero-dots');
  let activeIndex = 0;

  cards.forEach((_, i) => {
    const dot = document.createElement('span');
    if (i === 0) dot.classList.add('active');
    dotsContainer.appendChild(dot);
  });
  const dots = dotsContainer.querySelectorAll('span');

  function showSlide(i) {
    cards.forEach((c, idx) => c.classList.toggle('active', idx === i));
    dots.forEach((d, idx) => d.classList.toggle('active', idx === i));
    activeIndex = i;
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (cards.length > 1 && !reduceMotion) {
    setInterval(() => showSlide((activeIndex + 1) % cards.length), 4000);
  }
</script>